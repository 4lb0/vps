# .env.example para Laravel en Nube
#
# Copialo a tu repo como .env.example y versioná SOLO este archivo.
# El hook reemplaza los placeholders en cada deploy.

APP_NAME="Mi App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=#NUBE_URL#

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=#NUBE_DB_CONN#
DB_HOST=#NUBE_DB_HOST#
DB_PORT=#NUBE_DB_PORT#
DB_DATABASE=#NUBE_DB_NAME#
DB_USERNAME=#NUBE_DB_USER#
DB_PASSWORD=#NUBE_DB_PASS#

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database

# Secretos adicionales: dejalos fuera del repo y agregalos en el .env del
# servidor.
MAIL_MAILER=log
