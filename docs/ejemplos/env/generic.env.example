# .env.example generico para Nube (PHP propio, Node, Python…)
#
# El hook reemplaza los placeholders #NUBE_*# en cada deploy.

APP_ENV=production
APP_URL=#NUBE_URL#
APP_ROOT=#NUBE_ROOT#

DB_CONNECTION=#NUBE_DB_CONN#
DB_HOST=#NUBE_DB_HOST#
DB_PORT=#NUBE_DB_PORT#
DB_NAME=#NUBE_DB_NAME#
DB_USER=#NUBE_DB_USER#
DB_PASSWORD=#NUBE_DB_PASS#
