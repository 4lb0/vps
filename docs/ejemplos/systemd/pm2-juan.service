# /etc/systemd/system/pm2-juan.service
#
# Mantiene vivo el daemon de PM2 del usuario de deploy "juan",
# incluso despues de un reboot.
#
# Instalacion (como root):
#   npm install -g pm2
#   runuser -u juan -- env HOME=/home/juan pm2 startup systemd -u juan --hp /home/juan
#   # PM2 imprime el comando; si preferis usar este archivo:
#   cp docs/ejemplos/systemd/pm2-juan.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now pm2-juan
#
# El usuario define sus apps con pm2 startOrReload ecosystem.config.js
# y luego pm2 save.

[Unit]
Description=PM2 para el usuario juan (Nube)
After=network.target

[Service]
Type=forking
User=juan
Group=juan
Environment=HOME=/home/juan
Environment=PM2_HOME=/home/juan/.pm2
Environment=PATH=/home/juan/.nvm/versions/node/current/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/pm2 resurrect
ExecReload=/usr/local/bin/pm2 reload all
ExecStop=/usr/local/bin/pm2 kill
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
