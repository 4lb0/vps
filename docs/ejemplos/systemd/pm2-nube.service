# /etc/systemd/system/pm2-nube.service
#
# Mantiene vivo el daemon de PM2 del usuario de deploy "nube",
# incluso despues de un reboot.
#
# Instalacion (como root):
#   npm install -g pm2
#   runuser -u nube -- env HOME=/home/nube pm2 startup systemd -u nube --hp /home/nube
#   # PM2 imprime el comando; si preferis usar este archivo:
#   cp docs/ejemplos/systemd/pm2-nube.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now pm2-nube
#
# El usuario define sus apps con pm2 startOrReload ecosystem.config.js
# y luego pm2 save.

[Unit]
Description=PM2 para el usuario nube (Nube)
After=network.target

[Service]
Type=forking
User=nube
Group=nube
Environment=HOME=/home/nube
Environment=PM2_HOME=/home/nube/.pm2
Environment=PATH=/home/nube/.nvm/versions/node/current/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/pm2 resurrect
ExecReload=/usr/local/bin/pm2 reload all
ExecStop=/usr/local/bin/pm2 kill
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
